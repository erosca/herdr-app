#!/bin/sh
# Herdr from this fork, with personal render settings.
# Written by personal/setup.sh; edit personal/herdr-app.in instead.
# Text like Tilix (all machines): thinner light-on-dark strokes, and cells and
# glyph positions measured as VTE terminals do (whole-pixel cells, no extra
# line spacing, regular weight).
export ZED_FONTS_GAMMA=1.0 HERDR_VTE_COMPAT=1
#NOMACHINE # NoMachine desktop (setup.sh --nomachine): its session exports
#NOMACHINE # WAYLAND_DISPLAY=no. No backend is forced: NVIDIA's Vulkan draws into
#NOMACHINE # NoMachine's display (scripts/cpu_check.py: 58% CPU scrolling, against 976%
#NOMACHINE # with GL on llvmpipe). Partial redraw only acts if it falls back to llvmpipe.
#NOMACHINE # Scrolling output then drew ~60 times a second, ~10 ms of CPU each; NoMachine
#NOMACHINE # streams the screen at about 30 frames a second, so draws are capped there.
#NOMACHINE unset WAYLAND_DISPLAY WAYLAND_SOCKET
#NOMACHINE export HERDR_RENDER_PARTIAL=cpu HERDR_MAX_FPS=30
exec "@REPO@/target/release/herdr-app" "$@"
